DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

B2_BUCKET_NAME=georgia-ev-raw-documents
B2_ENDPOINT_URL=https://s3.REGION.backblazeb2.com
B2_REGION=REGION
B2_ACCESS_KEY_ID=your_backblaze_key_id
B2_SECRET_ACCESS_KEY=your_backblaze_application_key

# Tavily search keys. Put all free-tier keys here, comma-separated.
# The pipeline rotates through them one after another and temporarily skips a key
# when Tavily returns auth/rate/quota errors.
TAVILY_API_KEYS=tvly-key-1,tvly-key-2,tvly-key-3

# Optional single-key fallback if you do not use TAVILY_API_KEYS.
TAVILY_API_KEY=tvly-key-1
